{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ma-brain/ClinRand/blob/main/docs/schema/study-config-1.0.json",
  "title": "ClinRand study configuration",
  "description": "Published wire format for ClinRand study configs (plan §5.1). method is a string sibling of optional block; numbering uses a kind tag. Arithmetic rules such as ratio-sum multiples are enforced by validate_config, not this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "protocol_version",
    "arms",
    "method",
    "strata",
    "list_length_per_stratum",
    "numbering"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "study_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_version": {
      "type": "string",
      "minLength": 1
    },
    "arms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/arm"
      }
    },
    "method": {
      "type": "string",
      "enum": ["simple", "permuted_block", "stratified_block"]
    },
    "block": {
      "$ref": "#/$defs/block"
    },
    "strata": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/factor"
      }
    },
    "list_length_per_stratum": {
      "type": "integer",
      "minimum": 0
    },
    "numbering": {
      "$ref": "#/$defs/numbering"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "method": {
            "const": "simple"
          }
        },
        "required": ["method"]
      },
      "then": {
        "not": {
          "required": ["block"]
        }
      }
    },
    {
      "if": {
        "properties": {
          "method": {
            "enum": ["permuted_block", "stratified_block"]
          }
        },
        "required": ["method"]
      },
      "then": {
        "required": ["block"]
      }
    }
  ],
  "$defs": {
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "label", "ratio"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,12}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "ratio": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "size"],
          "properties": {
            "kind": {
              "const": "fixed"
            },
            "size": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sizes"],
          "properties": {
            "kind": {
              "const": "variable"
            },
            "sizes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "factor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "levels"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,32}$"
        },
        "levels": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,32}$"
          }
        }
      }
    },
    "numbering": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "start", "width"],
          "properties": {
            "kind": {
              "const": "global"
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "width": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "start", "block_size", "width"],
          "properties": {
            "kind": {
              "const": "per_stratum_range"
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "block_size": {
              "type": "integer",
              "minimum": 0
            },
            "width": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          }
        }
      ]
    }
  }
}
